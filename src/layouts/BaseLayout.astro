---
import "@/styles/tokens.css";
import "@/styles/base.css";
import Nav from "@/components/layout/Nav.astro";
import Starfield from "@/components/galaxy/Starfield.astro";
import NoiseOverlay from "@/components/ui/NoiseOverlay.astro";
import CustomCursor from "@/components/ui/CustomCursor.astro";
import { CommandPalette } from "@/components/islands/CommandPalette";
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
  starfield?: boolean;
}

const { title, starfield = true } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Manrope:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
  </head>
  <body>
    {starfield && <Starfield />}
    <Nav />
    <slot />
    <CommandPalette client:load />
    <NoiseOverlay />
    <CustomCursor />
  </body>
</html>

<style is:global>
  /* Cross-fade between pages. The whole page, main included, fades over the slow duration. */
  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation-duration: var(--duration-slow);
  }
</style>
