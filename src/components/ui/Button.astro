---
interface Props {
  variant?: "primary" | "secondary";
  size?: "md" | "sm";
  href?: string;
  external?: boolean;
  type?: "button" | "submit";
  disabled?: boolean;
}

const { variant = "secondary", size = "md", href, external = false, type = "button", disabled = false } = Astro.props;
---

{href ? (
  <a
    class="button"
    data-variant={variant}
    data-size={size}
    href={href}
    target={external ? "_blank" : undefined}
    rel={external ? "noopener noreferrer" : undefined}
  >
    <slot />
  </a>
) : (
  <button class="button" data-variant={variant} data-size={size} type={type} disabled={disabled}>
    <slot />
  </button>
)}

<style>
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-3) var(--space-6);
    font-size: var(--text-base);
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
    cursor: pointer;
    border: 1px solid transparent;
    border-radius: var(--radius-pill);
    transition:
      background-color var(--duration-base) var(--ease-standard),
      border-color var(--duration-base) var(--ease-standard),
      filter var(--duration-base) var(--ease-standard);
  }

  .button[data-size="sm"] {
    padding: var(--space-2) var(--space-4);
    font-size: var(--text-sm);
  }

  .button[data-variant="primary"] {
    color: var(--color-accent-ink);
    background: var(--color-accent);
  }

  .button[data-variant="primary"]:hover {
    filter: brightness(1.08);
  }

  .button[data-variant="secondary"] {
    color: var(--color-text);
    background: transparent;
    border-color: var(--color-line);
  }

  .button[data-variant="secondary"]:hover {
    border-color: var(--color-text-muted);
  }

  .button:disabled {
    cursor: not-allowed;
    opacity: 0.5;
    filter: none;
  }
</style>
