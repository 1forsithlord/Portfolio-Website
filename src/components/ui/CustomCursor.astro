<div class="cursor-ship" id="cursor-ship" aria-hidden="true">
  <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path
      d="M21 12L3 20L6 12L3 4L21 12Z"
      fill="var(--color-cobalt)"
      stroke="var(--color-text)"
      stroke-width="1.5"
      stroke-linejoin="round"
    />
    <circle cx="6" cy="12" r="1.5" fill="var(--color-text)" />
  </svg>
</div>
<div class="cursor-ring" id="cursor-ring" aria-hidden="true"></div>

<style is:global>
  @media (pointer: coarse) {
    .cursor-ship,
    .cursor-ring {
      display: none !important;
    }
  }

  @media (pointer: fine) {
    body,
    a,
    button,
    [role="button"],
    input,
    textarea {
      cursor: none !important;
    }
  }

  .cursor-ship {
    position: fixed;
    top: 0;
    left: 0;
    width: 24px;
    height: 24px;
    pointer-events: none;
    z-index: 10000;
    transform: translate(-50%, -50%);
    opacity: 0; /* Start hidden */
    transition:
      opacity 0.2s ease,
      transform 0.1s linear;
  }

  .cursor-ring {
    position: fixed;
    top: 0;
    left: 0;
    width: 40px;
    height: 40px;
    border: 1px dashed var(--color-cobalt);
    border-radius: 50%;
    pointer-events: none;
    z-index: 9999;
    transform: translate(-50%, -50%);
    opacity: 0; /* Start hidden */
    transition:
      opacity 0.2s ease,
      width var(--duration-base) var(--ease-standard),
      height var(--duration-base) var(--ease-standard),
      border-style var(--duration-base) var(--ease-standard),
      background-color var(--duration-base) var(--ease-standard);
  }

  .cursor-visible {
    opacity: 1 !important;
  }

  .cursor-ring.cursor-hovering {
    width: 60px;
    height: 60px;
    border-style: solid;
    border-color: var(--color-cobalt);
    background-color: var(--glow-cobalt);
  }
</style>

<script>
  // This listener ensures the script runs on initial load AND every time Astro navigates to a new page.
  document.addEventListener("astro:page-load", () => {
    const ship = document.getElementById("cursor-ship") as HTMLDivElement;
    const ring = document.getElementById("cursor-ring") as HTMLDivElement;

    if (!ship || !ring) return; // Safe guard

    if (window.matchMedia("(pointer: fine)").matches) {
      let mouseX = window.innerWidth / 2;
      let mouseY = window.innerHeight / 2;
      let shipX = mouseX;
      let shipY = mouseY;
      let ringX = mouseX;
      let ringY = mouseY;
      let currentAngle = 0;

      // Show cursor on any mouse movement
      window.addEventListener(
        "mousemove",
        (e) => {
          ship.classList.add("cursor-visible");
          ring.classList.add("cursor-visible");
          mouseX = e.clientX;
          mouseY = e.clientY;
        },
        { passive: true },
      );

      // Hide cursor when leaving the browser window entirely
      window.addEventListener("mouseout", (e) => {
        if (!e.relatedTarget) {
          ship.classList.remove("cursor-visible");
          ring.classList.remove("cursor-visible");
        }
      });

      const animate = () => {
        const dx = mouseX - shipX;
        const dy = mouseY - shipY;

        shipX += dx * 0.35;
        shipY += dy * 0.35;

        if (Math.abs(dx) > 0.1 || Math.abs(dy) > 0.1) {
          const targetAngle = Math.atan2(dy, dx) * (180 / Math.PI);
          let angleDiff = targetAngle - currentAngle;
          while (angleDiff > 180) angleDiff -= 360;
          while (angleDiff < -180) angleDiff += 360;
          currentAngle += angleDiff * 0.15;
        }

        ship.style.transform = `translate(${shipX}px, ${shipY}px) translate(-50%, -50%) rotate(${currentAngle}deg)`;

        ringX += (mouseX - ringX) * 0.1;
        ringY += (mouseY - ringY) * 0.1;
        ring.style.transform = `translate(${ringX}px, ${ringY}px) translate(-50%, -50%)`;

        requestAnimationFrame(animate);
      };
      requestAnimationFrame(animate);

      // Hover effects
      document.addEventListener("mouseover", (e) => {
        const target = e.target as HTMLElement;
        if (target.closest('a, button, [role="button"], input, textarea')) {
          ring.classList.add("cursor-hovering");
        }
      });

      document.addEventListener("mouseout", (e) => {
        const target = e.target as HTMLElement;
        if (target.closest('a, button, [role="button"], input, textarea')) {
          ring.classList.remove("cursor-hovering");
        }
      });
    }
  });
</script>
