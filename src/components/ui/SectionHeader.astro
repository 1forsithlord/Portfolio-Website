---
interface Props {
  title: string;
  level?: 1 | 2 | 3;
  id?: string;
  eyebrow?: string;
  description?: string;
}

const { title, level = 2, id, eyebrow, description } = Astro.props;
const Heading = `h${level}` as "h1" | "h2" | "h3";
---

<header class="section-header" data-level={level}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <Heading class="title" id={id}>{title}</Heading>
  {description && <p class="description">{description}</p>}
</header>

<style>
  .section-header {
    display: grid;
    gap: var(--space-2);
    max-width: var(--measure);
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  /* Interim sizes. The shared type scale replaces these in step 2.2. */
  .title {
    font-size: 1.25rem;
  }

  .section-header[data-level="2"] .title {
    font-size: 1.75rem;
  }

  .section-header[data-level="1"] .title {
    font-size: clamp(2rem, 6vw, 3rem);
  }

  .description {
    color: var(--color-text-muted);
  }
</style>