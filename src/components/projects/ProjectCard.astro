---
import type { Project } from "@/content/projects";
import { getRepoStats } from "@/lib/github";
import GlassPanel from "@/components/ui/GlassPanel.astro";
import Tag from "@/components/ui/Tag.astro";
import Button from "@/components/ui/Button.astro";
import Planet from "@/components/ui/Planet.astro";

interface Props {
  project: Project;
}

const { project } = Astro.props;
// Null when there is no repo or the snapshot has no valid entry. The card then shows exactly what projects.ts holds.
const stats = getRepoStats(project.repoUrl);
const pushedOn = stats?.pushedAt ? stats.pushedAt.slice(0, 10) : null;
---

<GlassPanel as="article">
  <div class="body">
    <Planet variant="spotted" size="sm" />
    <h3>
      <a href={`/projects/${project.slug}`}>{project.title}</a>
    </h3>
    <p class="summary">{project.summary}</p>

    <!-- NEW: Render metrics if they exist -->
    {project.metrics && project.metrics.length > 0 && (
      <ul class="metrics" aria-label="Key Metrics">
        {project.metrics.map((metric) => (
          <li class="metric-pill">{metric}</li>
        ))}
      </ul>
    )}

    {stats && (
      <ul class="meta" aria-label="Repository">
        {stats.archived && <li>Archived</li>}
        <li>★ {stats.stars}</li>
        {stats.language && <li>{stats.language}</li>}
        {pushedOn && <li>Updated {pushedOn}</li>}
      </ul>
    )}
    {project.stack.length > 0 && (
      <ul class="stack" aria-label="Tech stack">
        {project.stack.map((item) => (
          <li>
            <Tag>{item}</Tag>
          </li>
        ))}
      </ul>
    )}
    {project.repoUrl && (
      <div class="actions">
        <Button href={project.repoUrl} external size="sm">
          Code
        </Button>
      </div>
    )}
  </div>
</GlassPanel>

<style>
  .body {
    position: relative;
    display: grid;
    align-content: start;
    gap: var(--space-3);
  }

  h3 {
    font-size: var(--text-xl);
  }

  h3 a {
    color: var(--color-text);
    text-decoration: none;
    transition: color var(--duration-base) var(--ease-standard);
  }

  h3 a:hover {
    color: var(--color-text-muted);
  }

  .summary {
    color: var(--color-text-muted);
    padding-right: 4.5rem;
  }

  /* NEW: Styles for the metrics */
  .metrics {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    padding: 0 4.5rem 0 0;
    margin-top: var(--space-1);
  }

  .metric-pill {
    padding: var(--space-1) var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-cobalt);
    background: rgba(0, 85, 255, 0.1);
    border: 1px solid var(--color-cobalt);
    border-radius: var(--radius-pill);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    list-style: none;
    padding: 0 4.5rem 0 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    padding: 0 4.5rem 0 0;
  }

  .actions {
    justify-self: start;
  }
</style>
