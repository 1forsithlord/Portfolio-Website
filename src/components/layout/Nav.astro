---
import { site, nav } from "@/content/site";

const path = Astro.url.pathname.replace(/\/+$/, "") || "/";

function isActive(href: string): boolean {
  if (href === "/") return path === "/";
  return path === href || path.startsWith(`${href}/`);
}
---

<header class="site-header">
  <nav aria-label="Primary">
    <a class="brand" href="/">{site.brand}</a>
    <ul>
      {
        nav.map((item) => (
          <li>
            <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
      <li>
        <a href={site.githubUrl} target="_blank" rel="noopener noreferrer">GitHub</a>
      </li>
    </ul>
  </nav>
</header>

<style>
  .site-header {
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-line);
  }

  @supports (background: color-mix(in srgb, red 50%, transparent)) {
    .site-header {
      background: color-mix(in srgb, var(--color-bg) 72%, transparent);
      -webkit-backdrop-filter: var(--backdrop-soft);
      backdrop-filter: var(--backdrop-soft);
    }
  }

  /* Sticky only where there is room. On phones the nav wraps to two rows. */
  @media (min-width: 640px) {
    .site-header {
      position: sticky;
      top: 0;
      z-index: var(--z-nav);
    }
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0 var(--space-6);
    max-width: var(--container-max);
    min-height: var(--nav-height);
    margin-inline: auto;
    padding: 0 var(--space-4);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-4);
    list-style: none;
    padding: 0;
  }

  a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--duration-base) var(--ease-standard);
  }

  a:hover {
    color: var(--color-text);
  }

  a[aria-current="page"] {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.5em;
  }

  .brand {
    font-family: var(--font-mono);
    color: var(--color-text);
  }
</style>