<style>
  /* z-index below zero: above the page background, below all normal content. */
  .galaxy {
    position: fixed;
    top: 0;
    left: 0;
    z-index: var(--z-behind);
    width: 100%;
    height: 100vh;
    height: 100lvh;
    pointer-events: none;
    opacity: 0;
    transition: opacity var(--duration-scene) var(--ease-standard);
  }

  .galaxy[data-galaxy="ready"] {
    opacity: 1;
  }

  /* Narrow screens: the galaxy sits closer to the text, so keep it dimmer. */
