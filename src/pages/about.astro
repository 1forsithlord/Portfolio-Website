---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import GlassPanel from "@/components/ui/GlassPanel.astro";
import Tag from "@/components/ui/Tag.astro";
import { Terminal } from "@/components/islands/Terminal";
import { ActivityFeed } from "@/components/islands/ActivityFeed";
import { activity } from "@/content/activity";
import { projects } from "@/content/projects";
import GitHubStats from "@/components/about/GitHubStats.astro";
import LeetCodeStats from "@/components/about/LeetCodeStats.astro";

const focus = ["Machine learning", "Full-stack", "Systems"];

// Every tag from the project stacks, once each, in alphabetical order.
const stack = [...new Set(projects.flatMap((project) => project.stack))].sort((a, b) => a.localeCompare(b));
---

<BaseLayout title="About — Yash Pratap Singh">
  <main>
    <SectionHeader level={1} title="About" />

    <div class="bento">
      <div class="tile tile--bio">
        <GlassPanel as="section">
          <div class="bio">
            <img
              class="photo"
              src="/MYPHOTO.jpeg"
              alt="Portrait of Yash Pratap Singh"
              width="571"
              height="821"
              loading="lazy"
            />
            <div class="bio-text">
              <h2 class="tile-title">Who I am</h2>
              <p>
                I'm a final-year computer science student who likes building things end to end — from a rough idea to
                something someone can actually open and use. I'm working across full-stack development, machine
                learning, and systems programming at the same time, and learning fastest by shipping real projects.
              </p>
              <p>
                Outside of coursework I tinker with local AI tooling, small desktop apps, and games — usually because I
                wanted to learn how a piece of it worked.
              </p>
              <ul class="tags" aria-label="Focus areas">
                {focus.map((item) => (
                  <li>
                    <Tag tone="accent">{item}</Tag>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </GlassPanel>
      </div>

      <div class="tile tile--github">
        <GlassPanel>
          <h2 class="tile-title">GitHub Activity</h2>
          <GitHubStats />
        </GlassPanel>
      </div>

      <div class="tile tile--leetcode">
        <GlassPanel>
          <h2 class="tile-title">LeetCode Activity</h2>
          <LeetCodeStats />
        </GlassPanel>
      </div>

      <div class="tile tile--stack">
        <GlassPanel>
          <h2 class="tile-title">Tech stack</h2>
          <ul class="tags" aria-label="Tech stack">
            {stack.map((item) => (
              <li>
                <Tag>{item}</Tag>
              </li>
            ))}
          </ul>
        </GlassPanel>
      </div>

      <div class="tile tile--terminal">
        <GlassPanel as="section">
          <h2 class="tile-title">Try the terminal</h2>
          <p class="muted">Type help to see what it can do. It is a shortcut to the rest of the site.</p>
          <Terminal client:visible />
        </GlassPanel>
      </div>

      {activity.length > 0 && (
        <div class="tile tile--activity">
          <GlassPanel as="section">
            <h2 class="tile-title">Recent activity</h2>
            <p class="muted">Dated entries I add by hand.</p>
            <ActivityFeed items={activity} client:visible />
          </GlassPanel>
        </div>
      )}
    </div>
  </main>
</BaseLayout>

<style>
  main {
    display: grid;
    gap: var(--space-8);
    max-width: var(--container-max);
    margin-inline: auto;
    padding: var(--space-12) var(--space-4);
  }

  /* Mobile first: one column. */
  .bento {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
  }

  /* Each tile is an outer element (it lifts and glows) around a GlassPanel (it owns the blur). */
  .tile {
    min-width: 0;
    border-radius: var(--radius-lg);
    transition:
      transform var(--duration-base) var(--ease-standard),
      box-shadow var(--duration-base) var(--ease-standard);
  }

  .tile:hover,
  .tile:focus-within {
    transform: translateY(-4px);
    box-shadow:
      0 0 0 1px var(--color-cobalt),
      0 16px 48px var(--glow-cobalt);
  }

  .tile-title {
    margin-bottom: var(--space-3);
    font-size: var(--text-xl);
  }

  .muted {
    color: var(--color-text-muted);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
  }

  .bio {
    display: grid;
    gap: var(--space-6);
  }

  .photo {
    width: 100%;
    max-width: 14rem;
    height: auto;
    aspect-ratio: 571 / 821;
    object-fit: cover;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
  }

  .bio-text {
    display: grid;
    align-content: start;
    gap: var(--space-4);
  }

  /* Tablet: two columns. */
  @media (min-width: 640px) {
    .bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .bio {
      grid-template-columns: 12rem 1fr;
      align-items: start;
    }

    .tile--bio,
    .tile--terminal {
      grid-column: span 2;
    }
  }

  /* Desktop: four columns, dense packing so the boxes fill the gaps. */
  @media (min-width: 1000px) {
    .bento {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-auto-flow: dense;
    }

    .tile--bio {
      grid-column: span 2;
      grid-row: span 2;
    }

    .tile--github,
    .tile--leetcode,
    .tile--stack,
    .tile--activity {
      grid-column: span 2;
    }

    .tile--terminal {
      grid-column: span 4;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tile:hover,
    .tile:focus-within {
      transform: none;
    }
  }
</style>
