---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import Tag from "@/components/ui/Tag.astro";

const focus = ["Machine learning", "Full-stack", "Systems"];
---

<BaseLayout title="About — Yash Pratap Singh">
  <main>
    <img
      class="photo"
      src="/MYPHOTO.jpeg"
      alt="Portrait of Yash Pratap Singh"
      width="571"
      height="821"
    />
    <div class="text">
      <SectionHeader level={1} title="About" />
      <p>
        I'm a final-year computer science student who likes building things end to end — from a rough idea to something someone can actually open and use. I'm working across full-stack development, machine learning, and systems programming at the same time, and learning fastest by shipping real projects.
      </p>
      <p>
        Outside of coursework I tinker with local AI tooling, small desktop apps, and games — usually because I wanted to learn how a piece of it worked.
      </p>
      <ul class="focus" aria-label="Focus areas">
        {
          focus.map((item) => (
            <li>
              <Tag tone="accent">{item}</Tag>
            </li>
          ))
        }
      </ul>
    </div>
  </main>
</BaseLayout>

<style>
  main {
    display: grid;
    gap: var(--space-8);
    max-width: var(--container-max);
    margin-inline: auto;
    padding: var(--space-12) var(--space-4);
  }

  .photo {
    width: 100%;
    max-width: 20rem;
    height: auto;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
  }

  .text {
    display: grid;
    align-content: start;
    gap: var(--space-4);
    max-width: var(--measure);
  }

  .focus {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
  }

  @media (min-width: 900px) {
    main {
      grid-template-columns: 20rem 1fr;
      gap: var(--space-12);
    }
  }
</style>