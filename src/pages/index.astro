---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/ui/Button.astro";
import { site } from "@/content/site";
import { projects } from "@/content/projects";

const featured = projects.filter((project) => project.featured);
---

<BaseLayout title={`${site.name} — Developer Portfolio`}>
  <main>
    <section class="hero" aria-labelledby="hero-title">
      <p class="eyebrow">{site.role}</p>
      <h1 id="hero-title">{site.name}</h1>
      <p class="pitch">{site.tagline}</p>
      <div class="actions">
        <Button variant="primary" href="/projects">View projects</Button>
        <Button href="/contact">Contact me</Button>
      </div>
    </section>

    <section class="featured" aria-labelledby="featured-title">
      <h2 id="featured-title" class="featured-title">Featured work</h2>
      <ul>
        {
          featured.map((project) => (
            <li>
              <a href={`/projects/${project.slug}`}>
                <span class="name">{project.title}</span>
                <span class="arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  main {
    display: grid;
    gap: var(--space-16);
    max-width: var(--container-max);
    margin-inline: auto;
    padding: var(--space-16) var(--space-4) var(--space-24);
  }

  .hero {
    display: grid;
    justify-items: start;
    gap: var(--space-6);
    min-height: 60dvh;
    align-content: center;
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  h1 {
    font-size: var(--text-hero);
    font-weight: 400;
    line-height: var(--leading-tight);
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .pitch {
    max-width: 38ch;
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    text-wrap: pretty;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .featured {
    display: grid;
    gap: var(--space-4);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-line);
  }

  .featured-title {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: var(--space-3) var(--space-6);
    list-style: none;
    padding: 0;
  }

  li a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: 2.75rem;
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--color-line);
    color: var(--color-text);
    text-decoration: none;
    transition:
      color var(--duration-base) var(--ease-standard),
      border-color var(--duration-base) var(--ease-standard);
  }

  li a:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .name {
    font-family: var(--font-display);
    font-size: var(--text-xl);
  }
</style>