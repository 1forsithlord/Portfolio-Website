---
import BaseLayout from "@/layouts/BaseLayout.astro";
import GlassPanel from "@/components/ui/GlassPanel.astro";
import Button from "@/components/ui/Button.astro";
import { ContactGraphic } from "@/components/islands/ContactGraphic";
---

<BaseLayout title="Contact — Yash Pratap Singh">
  <main class="page">
    <!-- LEFT SIDE: 3D Graphic & Intro -->
    <div class="side-info">
      <div class="graphic-container">
        <ContactGraphic client:load />
      </div>

      <div class="intro-text">
        <h1>Hey, I'm Yash. 👋</h1>
        <p>
          I build machine learning systems, full-stack apps, and interactive 3D web experiences. If you have a cool
          project in mind, or just want to talk shop about AI and engineering, drop me a line. Let's connect.
        </p>
        <div class="social-links">
          <a href="https://github.com/1forsithlord" target="_blank" rel="noopener noreferrer">
            GitHub
          </a>
          <a href="https://linkedin.com/in/your-linkedin" target="_blank" rel="noopener noreferrer">
            LinkedIn
          </a>
          <a href="mailto:yashpratapsingh321@gmail.com">Email</a>
        </div>
      </div>
    </div>

    <!-- RIGHT SIDE: The Form -->
    <div class="side-form">
      <GlassPanel>
        <div class="form-header">
          <h2>Get in touch</h2>
          <p>Fill out the form below and I'll get back to you within 24 hours.</p>
        </div>

        <form id="contact-form" action="https://api.web3forms.com/submit" method="POST">
          <input type="hidden" name="access_key" value="c352fa8e-e91f-40ba-94dd-d0d66dd76971" />

          <fieldset>
            <legend class="visually-hidden">Contact form</legend>

            <label for="name">Name</label>
            <input type="text" id="name" name="name" autocomplete="name" required />

            <label for="email">Email</label>
            <input type="email" id="email" name="email" autocomplete="email" required />

            <label for="message">Message</label>
            <textarea id="message" name="message" rows="5" required></textarea>

            <input
              type="checkbox"
              name="botcheck"
              class="hidden"
              style="display: none;"
              tabindex="-1"
              autocomplete="off"
            />

            <div class="actions">
              <Button id="submit-btn" variant="primary" type="submit">
                Send message
              </Button>
            </div>
          </fieldset>

          <p id="form-status" class="status" aria-live="polite"></p>
        </form>
      </GlassPanel>
    </div>
  </main>
</BaseLayout>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement;
  const status = document.getElementById("form-status") as HTMLParagraphElement;
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;

  if (form && status && submitBtn) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const formData = new FormData(form);

      submitBtn.disabled = true;
      submitBtn.textContent = "Sending...";
      status.textContent = "";
      status.className = "status";

      try {
        const response = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          body: formData,
        });
        const data = await response.json();

        if (data.success) {
          status.textContent = "Message sent successfully! I'll get back to you soon.";
          status.classList.add("success");
          form.reset();
        } else {
          status.textContent = "Something went wrong. Please try again.";
          status.classList.add("error");
        }
      } catch (error) {
        console.error("Form submission failed:", error);
        status.textContent = "Something went wrong. Please check your connection and try again.";
        status.classList.add("error");
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = "Send message";
      }
    });
  }
</script>

<style>
  .page {
    display: grid;
    gap: var(--space-8);
    max-width: var(--container-max);
    margin-inline: auto;
    padding: var(--space-12) var(--space-4);
    align-items: start;
  }

  @media (min-width: 900px) {
    .page {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
      gap: var(--space-12);
    }
  }

  .side-info {
    display: grid;
    gap: var(--space-6);
  }

  .graphic-container {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    background: radial-gradient(circle at center, rgba(21, 89, 203, 0.1) 0%, transparent 70%);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .graphic-container :global(astro-island) {
    display: block;
    height: 100%;
  }

  .intro-text h1 {
    font-size: var(--text-3xl);
    margin-bottom: var(--space-4);
    color: var(--color-text);
  }

  .intro-text p {
    color: var(--color-text-muted);
    margin-bottom: var(--space-6);
    font-size: var(--text-lg);
    line-height: var(--leading-body);
  }

  .social-links {
    display: flex;
    gap: var(--space-4);
  }

  .social-links a {
    color: var(--color-cobalt);
    text-decoration: none;
    font-weight: 600;
    transition: color var(--duration-base);
  }

  .social-links a:hover {
    color: var(--color-text);
  }

  .side-form :global(.surface) {
    padding: var(--space-6);
  }

  .form-header {
    margin-bottom: var(--space-6);
  }

  .form-header h2 {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-2);
  }

  .form-header p {
    color: var(--color-text-muted);
  }

  fieldset {
    display: grid;
    gap: var(--space-3);
    min-width: 0;
    padding: 0;
    border: 0;
  }

  input,
  textarea {
    width: 100%;
    padding: var(--space-3);
    background: var(--color-bg);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
    color: var(--color-text);
    transition: border-color var(--duration-base) var(--ease-standard);
  }

  input:focus,
  textarea:focus {
    outline: none;
    border-color: var(--color-cobalt);
  }

  .actions {
    justify-self: start;
    margin-top: var(--space-2);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .status {
    margin-top: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .status.success {
    color: #4ade80;
  }
  .status.error {
    color: #f87171;
  }
</style>
