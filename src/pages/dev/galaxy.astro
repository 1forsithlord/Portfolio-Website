---
import BaseLayout from "@/layouts/BaseLayout.astro";
import GlassPanel from "@/components/ui/GlassPanel.astro";
---

<BaseLayout title="Galaxy controller — temporary dev page">
  <div id="galaxy" class="stage"></div>
  <main>
    <GlassPanel>
      <h1>Galaxy controller</h1>
      <p class="note">Temporary dev page, 6 planets. Add ?tier=high, ?tier=medium or ?tier=low to fix the tier.</p>
      <p id="status" role="status">
        Starting…
      </p>
      <button id="replay" type="button">
        Replay motion
      </button>
    </GlassPanel>
  </main>
</BaseLayout>

<script>
  import { startGalaxy } from "@/lib/galaxy/controller";
  import type { TierName } from "@/lib/galaxy/tiers";

  const container = document.getElementById("galaxy");
  const status = document.getElementById("status");
  const replay = document.getElementById("replay");

  if (container && status && replay) {
    const param = new URLSearchParams(window.location.search).get("tier");
    const tier: TierName | undefined = param === "high" || param === "medium" || param === "low" ? param : undefined;

    const galaxy = startGalaxy({ container, planetCount: 6, tier });

    if (!galaxy) {
      status.textContent = "WebGL is not available here. The page stays a plain gradient.";
    } else {
      replay.addEventListener("click", () => galaxy.restartMotion());
      let lastDrawn = 0;
      let lastTime = performance.now();
      let fps = 0;
      window.setInterval(() => {
        const s = galaxy.status();
        const now = performance.now();
        if (now - lastTime >= 1000) {
          fps = Math.round(((s.drawn - lastDrawn) * 1000) / (now - lastTime));
          lastDrawn = s.drawn;
          lastTime = now;
        }
        status.textContent = `tier ${s.tier}, ${s.state}, ${s.settled ? "settled" : "easing"}, elapsed ${s.elapsed.toFixed(1)}s, clock ${s.rotate.toFixed(2)}, ${fps} fps`;
      }, 250);
      // Test hook, read by the browser tests only.
      Object.assign(window, { __galaxy: galaxy });
    }
  }
</script>

<style>
  .stage {
    position: fixed;
    inset: 0;
    z-index: var(--z-canvas);
  }

  main {
    position: relative;
    z-index: var(--z-content);
    display: grid;
    max-width: 28rem;
    margin: var(--space-12) var(--space-4);
  }

  h1 {
    font-size: var(--text-2xl);
  }

  .note {
    color: var(--color-text-muted);
  }

  #status {
    margin-top: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  button {
    justify-self: start;
    margin-top: var(--space-3);
    padding: var(--space-2) var(--space-4);
    font-size: var(--text-sm);
    background: transparent;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    cursor: pointer;
  }
</style>
