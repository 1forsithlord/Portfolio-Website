---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { HelloIsland } from "@/components/islands/HelloIsland";
---

<BaseLayout title="React check — temporary dev page">
  <main>
    <h1>React island check</h1>
    <p class="note">
      Temporary page. The button below proves React islands still hydrate. It is removed before promotion to main.
    </p>
    <HelloIsland client:load />
  </main>
</BaseLayout>

<style>
  main {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
    max-width: var(--container-max);
    margin-inline: auto;
    padding: var(--space-12) var(--space-4);
  }

  .note {
    max-width: var(--measure);
    color: var(--color-text-muted);
  }
</style>
