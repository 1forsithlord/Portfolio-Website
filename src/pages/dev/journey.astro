---
import BaseLayout from "@/layouts/BaseLayout.astro";
import GlassPanel from "@/components/ui/GlassPanel.astro";
---

<BaseLayout title="Scroll journey — temporary dev page">
  <div id="galaxy" class="stage"></div>
  <div id="track" class="track"></div>
  <aside class="hud">
    <GlassPanel>
      <h1>Scroll journey</h1>
      <p class="note">Temporary dev page. Scroll, or jump to a chapter.</p>
      <p id="status" role="status">Starting…</p>
      <div id="jumps" class="jumps"></div>
    </GlassPanel>
  </aside>
</BaseLayout>

<script>
  import { startGalaxy } from "@/lib/galaxy/controller";
  import { projects } from "@/content/projects";
  import { journeyLayout, nearestChapter } from "@/lib/journey/layout";
  import { createJourneyStore } from "@/lib/journey/store";

  const container = document.getElementById("galaxy");
  const track = document.getElementById("track");
  const status = document.getElementById("status");
  const jumps = document.getElementById("jumps");

  if (container && track && status && jumps) {
    const featured = projects.filter((project) => project.featured);
    const layout = journeyLayout(featured.length);
    const store = createJourneyStore({ track, layout });
    const galaxy = startGalaxy({ container, journey: { store, layout } });

    const label = (chapter: (typeof layout.chapters)[number]): string => {
      if (chapter.kind === "planet") return featured[chapter.planet ?? 0]?.title ?? "planet";
      return chapter.kind;
    };

    for (const chapter of layout.chapters) {
      const mark = document.createElement("div");
      mark.className = "mark";
      mark.style.top = `calc(${chapter.s} * 100lvh)`;
      mark.textContent = `s ${chapter.s.toFixed(1)}  ${label(chapter)}`;
      track.appendChild(mark);

      const button = document.createElement("button");
      button.type = "button";
      button.textContent = label(chapter);
      button.addEventListener("click", () => store.scrollToS(chapter.s));
      jumps.appendChild(button);
    }

    if (!galaxy) {
      status.textContent = "WebGL is not available here. Scrolling still works, the page keeps its gradient.";
    } else {
      window.setInterval(() => {
        const g = galaxy.status();
        const snap = store.getSnapshot();
        const near = nearestChapter(layout, snap.s);
        status.textContent = [
          `s ${snap.s.toFixed(2)} (page ${snap.target.toFixed(2)})`,
          `near ${label(near)}`,
          `dist ${g.camera.dist.toFixed(2)} pitch ${g.camera.pitch.toFixed(2)} yaw ${g.camera.yaw.toFixed(2)}`,
          `${g.tier}, ${g.state}, ${g.settled ? "settled" : "easing"}`,
        ].join("\n");
      }, 200);
      // Test hook, read by the browser tests only.
      Object.assign(window, { __galaxy: galaxy, __journey: { store, layout } });
    }
  }
</script>

<style>
  .stage {
    position: fixed;
    inset: 0;
    z-index: var(--z-canvas);
  }

  .track {
    position: relative;
    height: calc(var(--journey-screens, 8) * 100lvh);
  }

  .mark {
    position: absolute;
    left: 0;
    padding: var(--space-1) var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    border-top: 1px dashed var(--color-line);
    width: 100%;
  }

  .hud {
    position: fixed;
    top: calc(var(--nav-height) + var(--space-4));
    left: var(--space-4);
    z-index: var(--z-content);
    width: min(22rem, calc(100% - var(--space-8)));
  }

  h1 {
    font-size: var(--text-xl);
  }

  .note {
    color: var(--color-text-muted);
  }

  #status {
    margin-top: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    white-space: pre-line;
  }

  .jumps {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }

  button {
    padding: var(--space-1) var(--space-3);
    font-size: var(--text-xs);
    background: transparent;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    cursor: pointer;
  }
</style>