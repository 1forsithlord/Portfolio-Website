---
import BaseLayout from "@/layouts/BaseLayout.astro";

const colors = [
  "--color-bg",
  "--color-surface",
  "--color-surface-raised",
  "--color-text",
  "--color-text-muted",
  "--color-line",
  "--color-accent",
  "--color-accent-soft",
  "--color-accent-ink",
  "--color-violet",
  "--color-apricot",
  "--color-lagoon",
  "--color-focus",
];
const spacing = [1, 2, 3, 4, 6, 8, 12, 16, 24];
const radii = ["sm", "md", "lg", "pill"];
const layers = ["canvas", "content", "tags", "nav", "overlay", "modal"];
---

<BaseLayout title="Tokens — temporary dev page">
  <main>
    <h1>Design tokens</h1>
    <p class="note">Temporary page for checking tokens. It is removed before promotion to main.</p>

    <section>
      <h2>Color</h2>
      <ul class="swatches">
        {colors.map((name) => (
          <li>
            <span class="swatch" style={`background: var(${name})`} />
            <code>{name}</code>
          </li>
        ))}
      </ul>
    </section>

    <section>
      <h2>Spacing</h2>
      <ul class="bars">
        {spacing.map((n) => (
          <li>
            <code>--space-{n}</code>
            <span class="bar" style={`width: var(--space-${n})`} />
          </li>
        ))}
      </ul>
    </section>

    <section>
      <h2>Radius</h2>
      <ul class="radii">
        {radii.map((name) => (
          <li>
            <span class="box" style={`border-radius: var(--radius-${name})`} />
            <code>--radius-{name}</code>
          </li>
        ))}
      </ul>
    </section>

    <section>
      <h2>Glass</h2>
      <div class="stripe">
        <div class="glass">
          <p>
            <code>--glass-fill</code>, <code>--glass-border</code>, <code>--backdrop-strong</code>,{" "}
            <code>--shadow-glass</code>
          </p>
        </div>
      </div>
    </section>

    <section>
      <h2>Z layers</h2>
      <ul class="layers">
        {layers.map((name) => (
          <li>
            <code>--z-{name}</code>
          </li>
        ))}
      </ul>
    </section>

    <section>
      <h2>Motion</h2>
      <p class="note">Hover or focus the box. With reduced motion on, it jumps with no animation.</p>
      <div class="mover" tabindex="0">
        <span class="mover__dot"></span>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  main {
    display: grid;
    gap: var(--space-8);
    max-width: var(--container-max);
    margin-inline: auto;
    padding: var(--space-12) var(--space-4);
  }

  section {
    display: grid;
    gap: var(--space-3);
  }

  ul {
    display: grid;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
  }

  code {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .note {
    color: var(--color-text-muted);
    max-width: var(--measure);
  }

  .swatches {
    grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
  }

  .swatches li,
  .bars li,
  .radii li {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .swatch {
    flex: none;
    width: var(--space-8);
    height: var(--space-8);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
  }

  .bar {
    height: var(--space-3);
    background: var(--color-accent);
    border-radius: var(--radius-pill);
  }

  .radii {
    grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));
  }

  .box {
    flex: none;
    width: var(--space-16);
    height: var(--space-16);
    background: var(--color-surface-raised);
    border: 1px solid var(--color-line);
  }

  .stripe {
    display: grid;
    place-items: center;
    padding: var(--space-12) var(--space-4);
    border-radius: var(--radius-lg);
    background: linear-gradient(
      90deg,
      var(--color-accent),
      var(--color-violet),
      var(--color-lagoon),
      var(--color-apricot)
    );
  }

  .glass {
    padding: var(--space-6);
    background: var(--glass-fill);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    -webkit-backdrop-filter: var(--backdrop-strong);
    backdrop-filter: var(--backdrop-strong);
    box-shadow: var(--shadow-glass);
  }

  .glass code {
    color: var(--color-accent-ink);
  }

  .mover {
    width: 100%;
    max-width: 24rem;
    padding: var(--space-2);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
  }

  .mover__dot {
    display: block;
    width: var(--space-6);
    height: var(--space-6);
    background: var(--color-accent);
    border-radius: var(--radius-pill);
    transition: transform var(--duration-slow) var(--ease-emphasized);
  }

  .mover:hover .mover__dot,
  .mover:focus-visible .mover__dot {
    transform: translateX(12rem);
  }
</style>
