---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { projects } from "@/content/projects";
import { site } from "@/content/site";
---

<BaseLayout title="Content — temporary dev page">
  <main>
    <h1>{site.name}: content check</h1>
    <p class="note">
      Temporary page that lists everything in src/content/projects.ts. It is
      removed before promotion to main.
    </p>

    <ol>
      {
        projects.map((project) => (
          <li>
            <h2>
              {project.title} <code>{project.slug}</code>
              {project.featured && <span class="badge">featured</span>}
            </h2>
            <p>{project.summary}</p>
            <p class="meta">
              stack: {project.stack.length > 0 ? project.stack.join(", ") : "none yet"}
              {" · "}
              repo: {project.repoUrl ?? "not set"}
            </p>
          </li>
        ))
      }
    </ol>
  </main>
</BaseLayout>

<style>
  main {
    display: grid;
    gap: var(--space-6);
    max-width: var(--container-max);
    margin-inline: auto;
    padding: var(--space-12) var(--space-4);
  }

  ol {
    display: grid;
    gap: var(--space-6);
    list-style: none;
    padding: 0;
  }

  li {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
  }

  h2 {
    font-size: 1.25rem;
  }

  code,
  .meta {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .note {
    max-width: var(--measure);
    color: var(--color-text-muted);
  }

  .badge {
    margin-left: var(--space-2);
    padding: var(--space-1) var(--space-2);
    font-family: var(--font-body);
    font-size: 0.75rem;
    color: var(--color-accent-ink);
    background: var(--color-accent);
    border-radius: var(--radius-pill);
  }
</style>